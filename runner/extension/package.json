{
  "name": "codepilot-extension",
  "displayName": "CodePilot",
  "description": "CodePilot AI Assistant",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:codepilot-sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepilot",
          "title": "CodePilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codepilot": [
        {
          "type": "webview",
          "id": "codepilot-sidebar",
          "name": "CodePilot"
        }
      ]
    },
    "commands": [
      {
        "command": "codepilot.focus",
        "title": "Focus on CodePilot View"
      },
      {
        "command": "codepilot.openTerminal",
        "title": "Open CodePilot Terminal"
      },
      {
        "command": "codepilot.showSessions",
        "title": "Sessions",
        "icon": "$(history)"
      },
      {
        "command": "codepilot.showSettings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codepilot.showSessions",
          "group": "navigation@1",
          "when": "view == codepilot-sidebar"
        },
        {
          "command": "codepilot.showSettings",
          "group": "navigation@2",
          "when": "view == codepilot-sidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codepilot.focus",
        "key": "ctrl+alt+c"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "@types/markdown-it": "^13.0.7",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.1.3",
    "ts-loader": "^9.4.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.7.6"
  },
  "dependencies": {
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "markdown-it": "^14.1.0",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0"
  }
}